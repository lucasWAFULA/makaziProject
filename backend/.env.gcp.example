# ---------------------------------------------------------------------------
# Cloud Run (karibumakazi-api) — copy into Console → Cloud Run → Edit revision
# → Variables & Secrets, OR use scripts/gcp/patch-cors-firebase-hosting.ps1 for CORS only.
# Jobs (migrate / seed): see scripts/gcp/README.txt and run-cloud-run-job-*.ps1
# GCP project: makazi240097. Replace INSTANCE_NAME / Cloud Run host if yours differ (see gcloud commands below).
# ---------------------------------------------------------------------------
DEBUG=False
SECURE_SSL_REDIRECT=True
SECRET_KEY=use-secret-manager-in-production
ALLOWED_HOSTS=makazi-plus.com,www.makazi-plus.com,admin.makazi-plus.com,karibumakazi-api-dpifguofja-ew.a.run.app
SITE_URL=https://www.makazi-plus.com/
ADMIN_DOMAIN=admin.makazi-plus.com
DATABASE_URL=postgres://DB_USER:DB_PASSWORD@/DB_NAME?host=/cloudsql/makazi240097:europe-west1:karibumakazi-db
REDIS_URL=

# Browsers: include every origin that serves the SPA (custom domain + Firebase Hosting default host).
# https://makazi240097.web.app — default Firebase Hosting URL; add custom domains you use.
CORS_ORIGINS=https://makazi-plus.com,https://www.makazi-plus.com,https://makazi240097.web.app,https://makazi240097.firebaseapp.com
CSRF_TRUSTED_ORIGINS=https://makazi-plus.com,https://www.makazi-plus.com,https://admin.makazi-plus.com,https://karibumakazi-api-dpifguofja-ew.a.run.app,https://makazi240097.web.app,https://makazi240097.firebaseapp.com

USE_GCS=True
GS_BUCKET_NAME=makazi240097-karibumakazi-media
GS_PROJECT_ID=makazi240097
GS_DEFAULT_ACL=
GS_QUERYSTRING_AUTH=False

MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=use-secret-manager
MPESA_CONSUMER_SECRET=use-secret-manager
MPESA_PASSKEY=use-secret-manager
MPESA_SHORTCODE=
# Use the same base URL as Cloud Run (no trailing slash), from gcloud describe.
MPESA_CALLBACK_BASE_URL=https://karibumakazi-api-dpifguofja-ew.a.run.app

OPENAI_API_KEY=use-secret-manager
OPENAI_MODEL=gpt-4o-mini
AI_ASSISTANT_NAME=Makazi AI

# --- Email (Zoho SMTP) -------------------------------------------------
# Generate an "App Password" in Zoho (Security → App Passwords) and put it in EMAIL_HOST_PASSWORD.
# The EMAIL_HOST_USER must be a real Zoho mailbox (e.g. noreply@makazi-plus.com).
# DEFAULT_FROM_EMAIL can be the same mailbox or one of its aliases.
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=noreply@makazi-plus.com
EMAIL_HOST_PASSWORD=use-secret-manager
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=MakaziPlus <noreply@makazi-plus.com>
SUPPORT_EMAIL=support@makazi-plus.com
BOOKINGS_EMAIL=bookings@makazi-plus.com
HOSTS_EMAIL=hosts@makazi-plus.com
EMAIL_REPLY_TO=support@makazi-plus.com
EMAIL_NOTIFICATIONS_ENABLED=True
