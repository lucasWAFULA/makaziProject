DEBUG=True
SECURE_SSL_REDIRECT=False
SECRET_KEY=your-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL (replace with your user, password, and database name)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DATABASE

# Example: user kusajilisha, password mypass, database kusajilisha
# DATABASE_URL=postgres://kusajilisha:mypass@localhost:5432/kusajilisha

# Redis (optional; leave empty to disable)
REDIS_URL=

# Production (when using HTTPS behind nginx)
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Cloud Storage for uploaded media/documents.
# In Cloud Run, prefer Workload Identity/service account permissions instead of JSON keys.
USE_GCS=False
GS_BUCKET_NAME=
GS_PROJECT_ID=
GS_DEFAULT_ACL=
GS_QUERYSTRING_AUTH=False

USE_S3=False
MEDIA_ROOT=media

MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_BASE_URL=https://yourdomain.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ASSISTANT_NAME=Makazi AI

# --- Email (Zoho SMTP) -------------------------------------------------
# Leave EMAIL_HOST_USER and EMAIL_HOST_PASSWORD empty in development to fall
# back to Django's console backend (emails print to stdout, no SMTP needed).
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=MakaziPlus <noreply@makazi-plus.com>
SUPPORT_EMAIL=support@makazi-plus.com
BOOKINGS_EMAIL=bookings@makazi-plus.com
HOSTS_EMAIL=hosts@makazi-plus.com
EMAIL_REPLY_TO=support@makazi-plus.com
EMAIL_NOTIFICATIONS_ENABLED=True
