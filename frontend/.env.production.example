# Production env — copy to .env.production before building for production.
# DO NOT commit this file.

# Option A: Firebase Hosting rewrites /api/** to Cloud Run.
VITE_API_URL=/api

# Option B: Call Cloud Run directly.
# VITE_API_URL=https://karibumakazi-api-dpifguofja-ew.a.run.app/api

# Google Maps / Places API key
# Enable "Maps JavaScript API" and "Places API" in Google Cloud Console.
# Restrict this key to your Firebase Hosting domain for security.
VITE_GOOGLE_MAPS_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
