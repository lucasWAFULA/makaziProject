# ------------------------------------------------------------------
# MakaziPlus repo .gitignore
# Keeps secrets, build output, caches, and editor cruft out of git.
# ------------------------------------------------------------------

# --- Secrets / environment files ---------------------------------
.env
.env.*
!.env.example
!.env.*.example
backend/.env
backend/.env.local
*.secret

# --- Python ------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Virtual envs
venv/
.venv/
env/
ENV/

# Django collected/static & media uploads (we use cloud storage in prod)
backend/staticfiles/
backend/media/
backend/db.sqlite3
backend/db.sqlite3-journal

# --- Node / Frontend --------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/
.npm/
.yarn/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Firebase ----------------------------------------------------
.firebase/
firebase-debug.log
firebase-debug.*.log

# --- Editors / OS -----------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# --- Misc --------------------------------------------------------
*.tmp
*.bak
*.orig
